SATYAM_ENV=development
SATYAM_CORS_ORIGINS=http://localhost:5173
SATYAM_DB_PATH=satyam.db
SATYAM_MAX_IMAGE_MB=10
SATYAM_MAX_VIDEO_MB=50
SATYAM_MAX_AUDIO_MB=30
SATYAM_MAX_VIDEO_SECONDS=60
SATYAM_MAX_AUDIO_SECONDS=180
SATYAM_FRAME_INTERVAL_S=2
SATYAM_MAX_FRAMES=12
SATYAM_AUDIO_SEGMENT_SECONDS=10
SATYAM_RATE_LIMIT_PER_MIN=20
# Leave empty to run without the AI model (module is reported as unavailable).
SATYAM_HF_MODEL=
SATYAM_HF_MODEL_REVISION=
SATYAM_HF_FAKE_LABELS=artificial,fake,ai,ai-generated,generated
# Optional Hugging Face audio-classification model. Check model card, task support, labels and license.
SATYAM_AUDIO_MODEL=
SATYAM_AUDIO_MODEL_REVISION=
SATYAM_AUDIO_FAKE_LABELS=fake,spoof,synthetic,ai-generated,artificial
SATYAM_AUDIO_REAL_LABELS=real,bonafide,genuine
